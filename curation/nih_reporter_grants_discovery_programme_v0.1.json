    "endpoint": "https://api.reporter.nih.gov/v2/projects/search",
    "method": "POST",
    "request_media_type": "application/json",
    "response_media_type": "application/json",
    "reported_denominator_path": "meta.total",
    "offset_path": "meta.offset",
    "limit_path": "meta.limit",
    "results_path": "results",
    "primary_application_id_field": "appl_id",
    "max_records_per_request": 500,
    "max_offset": 14999,
    "recommended_max_requests_per_second": 1,
    "configuration_performs_http": false
  },
  "workbench_dependency": {
    "minimum_package_line": "0.3.0.dev0",
    "required_capability": "project_nih_reporter_search_pages",
    "integration_state": "PENDING_S1_MERGE"
  },
  "identity_policy": {
    "primary_identity": "NIH_REPORTER_APPL_ID",
    "application_id_auto_merge": false,
    "project_number_auto_merge": false,
    "core_project_lineage_auto_merge": false,
    "subproject_auto_parent_merge": false,
    "pi_name_auto_entity_merge": false,
    "organization_name_auto_entity_merge": false,
    "conflicting_same_appl_id_policy": "FAIL_CLOSED"
  },
  "inclusion_policy": {
