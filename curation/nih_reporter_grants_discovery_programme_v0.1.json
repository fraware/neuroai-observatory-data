    "automatic_assessment_mutation": false,
    "automatic_monitor_creation": false,
    "human_relevance_review_required": true
  },
  "pagination_partition_policy": {
    "page_limit": 500,
    "initial_offset": 0,
    "max_offset": 14999,
    "max_directly_pageable_result_count": 15000,
    "over_limit_policy": "PARTITION_BEFORE_MATERIALIZATION",
    "preferred_partition_dimensions": ["FISCAL_YEAR", "AWARD_NOTICE_DATE"],
    "silent_truncation_allowed": false,
    "partial_over_limit_candidate_emission_allowed": false,
    "partition_provenance_required": true
