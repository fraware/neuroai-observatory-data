  },
  "query_streams": [
    {
      "query_id": "DISCOVERY-REPORTER-BCI-001",
      "advanced_text_search": {"operator": "or", "search_field": "projecttitle,abstracttext,terms", "search_text": "\"brain-computer interface\" \"brain computer interface\" \"brain-machine interface\""},
      "cadence": "MONTHLY",
      "status": "ACTIVE",
      "scope_tiers": ["A"],
      "purpose": "Explicit BCI and brain-machine-interface funded-project discovery.",
      "completeness_claim": false
    },
    {
      "query_id": "DISCOVERY-REPORTER-NEURAL-DECODING-AI-001",
      "advanced_text_search": {"operator": "advanced", "search_field": "projecttitle,abstracttext,terms", "search_text": "(neural OR cortical OR brain) AND (decoder OR decoding) AND (machine learning OR deep learning OR artificial intelligence OR transformer)"},
      "cadence": "MONTHLY",
      "status": "ACTIVE",
      "scope_tiers": ["A", "B"],
      "purpose": "AI-enabled neural-decoding grants that may not use BCI terminology.",
      "completeness_claim": false
    },
    {
      "query_id": "DISCOVERY-REPORTER-CLOSED-LOOP-NEUROMODULATION-001",
      "advanced_text_search": {"operator": "advanced", "search_field": "projecttitle,abstracttext,terms", "search_text": "(deep brain stimulation OR neuromodulation OR neurostimulation) AND (adaptive OR closed loop) AND (algorithm OR machine learning OR prediction)"},
      "cadence": "MONTHLY",
      "status": "ACTIVE",
      "scope_tiers": ["A"],
      "purpose": "Adaptive and algorithmically controlled neuromodulation funding.",
      "completeness_claim": false
    },
    {
      "query_id": "DISCOVERY-REPORTER-EEG-MODELS-001",
      "advanced_text_search": {"operator": "advanced", "search_field": "projecttitle,abstracttext,terms", "search_text": "(EEG OR electroencephalography) AND (foundation model OR transformer OR self supervised OR representation learning)"},
      "cadence": "MONTHLY",
      "status": "ACTIVE",
      "scope_tiers": ["A", "B"],
      "purpose": "EEG model and representation-learning funding discovery.",
      "completeness_claim": false
    },
    {
      "query_id": "DISCOVERY-REPORTER-SPEECH-NEUROPROSTHESIS-001",
      "advanced_text_search": {"operator": "advanced", "search_field": "projecttitle,abstracttext,terms", "search_text": "(brain OR neural OR cortical) AND (speech OR communication) AND (decoder OR decoding OR neuroprosthesis)"},
      "cadence": "MONTHLY",
      "status": "ACTIVE",
      "scope_tiers": ["A"],
      "purpose": "Speech and communication neuroprosthesis funding discovery.",
      "completeness_claim": false
    },
    {
      "query_id": "DISCOVERY-REPORTER-VISUAL-NEUROPROSTHESIS-001",
      "advanced_text_search": {"operator": "advanced", "search_field": "projecttitle,abstracttext,terms", "search_text": "(retinal OR retina OR visual cortex) AND (prosthesis OR neuroprosthesis OR implant) AND (algorithm OR image processing OR machine learning)"},
      "cadence": "QUARTERLY",
      "status": "ACTIVE",
      "scope_tiers": ["A", "B"],
      "purpose": "Visual and retinal neuroprosthesis funding with computational-role terms.",
      "completeness_claim": false
    },
    {
      "query_id": "DISCOVERY-REPORTER-GREY-MENTAL-STATE-001",
      "advanced_text_search": {"operator": "advanced", "search_field": "projecttitle,abstracttext,terms", "search_text": "(EEG OR electroencephalography OR neural OR brain signal) AND (attention OR emotion OR fatigue OR cognitive state OR mental state) AND (classification OR prediction OR inference OR machine learning)"},
      "cadence": "QUARTERLY",
      "status": "ACTIVE",
      "scope_tiers": ["C"],
      "purpose": "Grey-area funding discovery for neural-derived attention, emotion, fatigue, cognitive-state or mental-state inference.",
      "completeness_claim": false
    }
  ],
  "candidate_projection": {
    "required_fields": [
      "appl_id",
      "project_num",
      "core_project_num",
      "subproject_id",
      "fiscal_year",
      "project_title",
      "abstract_text",
      "project_start_date",
      "project_end_date",
      "award_notice_date",
      "award_amount",
      "funding_mechanism",
      "agency_ic_admin",
      "organization",
      "principal_investigators",
      "query_memberships",
      "normalized_record_sha256"
    ],
    "raw_api_pages_emitted_to_s2": false,
    "pi_or_org_entity_relationships_created_in_projection": false,
    "award_amount_interpreted_as_research_success": false
  },
  "coverage_contract": {
    "required_metrics_per_leaf_query": [
      "supplied_page_count",
      "returned_record_count",
      "unique_appl_id_count",
      "reported_total_count",
      "reported_total_count_state",
      "offset_sequence_valid",
      "offset_coverage_state",
      "over_15000_limit",
      "partition_required",
      "known_controlled_duplicate_count",
      "new_candidate_count",
      "duplicate_representation_count",
      "unresolved_appl_id_count"
    ],
    "mechanical_completion_requires": {
      "reported_total_count_state": "CONSISTENT",
      "offset_sequence_valid": true,
      "offset_coverage_state": "MATCH",
      "over_15000_limit": false,
      "partition_required": false
    },
    "reporter_database_completeness_claim": false,
    "global_neuroai_grant_recall_claim": false,
    "query_recall_claim": false,
    "funding_success_claim": false
  },
  "human_review_contract": {
    "required_dispositions": ["ACCEPT", "REJECT", "DEFER", "EXCLUDE"],
    "review_questions": [
      "Is the funded project materially relevant to direct NeuroAI, enabling infrastructure or the declared grey-area capability?",
      "Is the application identity exact and distinct from project/core-project lineage?",
      "Can PI and recipient organization identities be resolved without name-only automatic merging?",
      "What exact relationship to a represented system, model, dataset or institution is supported by the award record?",
      "What inference is prohibited by the award record alone?"
    ],
    "automatic_acceptance": false,
    "award_is_research_success_evidence": false,
    "award_is_system_effectiveness_evidence": false,
    "award_is_commercial_strength_evidence": false
  },
  "network_policy": {
    "live_execution": "OPT_IN_ONLY",
    "requires_workbench_network_gate": true,
    "recommended_max_requests_per_second": 1,
    "large_job_schedule_guidance_preserved": true,
    "configuration_performs_http": false,
    "hosted_success_claim_allowed_without_runner_steps": false
  },
  "boundary": "This programme defines bounded NIH RePORTER-funded-project discovery. An award record establishes a public funding/project record within the provider data; it does not establish research success, scientific validity, system effectiveness, commercialization, current implementation, ethical acceptability, regulatory authorization, system conformance, global grant completeness or UNESCO/institutional endorsement."
