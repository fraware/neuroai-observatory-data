    "provider_supports_bulk_downloads":true,
    "configuration_performs_http":false
  },
  "workbench_dependency":{"minimum_package_line":"0.3.0.dev0","required_capability":"project_openfda_510k_pages","integration_state":"NOT_IMPLEMENTED"},
  "identity_policy":{
    "primary_identity":"K_NUMBER",
    "admitted_prefixes":["K","BK"],
    "den_prefix_is_de_novo_and_out_of_scope_for_v0_1":true,
    "same_device_name_auto_merge":false,
    "same_applicant_auto_entity_merge":false,
    "product_code_auto_system_merge":false,
    "openfda_harmonized_fields_auto_identity_merge":false,
    "record_content_change_is_successor_observation_not_new_submission_identity":true,
    "conflicting_same_k_number_policy":"FAIL_CLOSED"
  },
  "inclusion_policy":{
    "candidate_scope":"DECLARED_OPENFDA_510K_SEARCH_MATCH_WITH_K_OR_BK_PREFIX",
    "automatic_source_admission":false,
    "automatic_system_or_device_entity_creation":false,
    "automatic_applicant_entity_creation":false,
    "automatic_predicate_relationship_creation":false,
    "automatic_global_authorization_claim_creation":false,
    "automatic_safety_effectiveness_claim_creation":false,
    "automatic_system_conformance_claim_creation":false,
    "automatic_assessment_mutation":false,
    "automatic_reopening_decision":false,
    "automatic_monitor_creation":false,
    "human_relevance_review_required":true
  },
  "paging_policy":{
    "execution_mode_v0_1":"SKIP_LIMIT_BOUNDED",
    "page_limit":1000,
    "initial_skip":0,
    "max_skip":25000,
    "max_direct_result_count":26000,
    "over_limit_policy":"SEARCH_AFTER_OR_DECISION_DATE_PARTITION_REQUIRED_BEFORE_MATERIALIZATION",
