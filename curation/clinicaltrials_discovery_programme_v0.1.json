      "page_size": 100,
      "cadence": "MONTHLY",
      "status": "ACTIVE",
      "purpose": "Bounded discovery stream for studies explicitly described as neural prostheses.",
      "completeness_claim": false
    },
    {
      "query_id": "DISCOVERY-CTGOV-BRAIN-IMPLANT-001",
      "query_term": "\"brain implant\" AND (interface OR prosthesis)",
