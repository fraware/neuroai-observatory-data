{
  "$id": "source-namespace-successor-proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft NeuroAI Observatory Source-namespace successor proposal",
  "description": "Noncanonical proposal to add explicitly human-accepted public source identities to a future Source namespace successor. It does not create monitors or canonical Sources by itself.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "artifact": {"const": "source_namespace_successor_proposal"},
    "status": {"const": "DRAFT_NONCANONICAL_SOURCE_NAMESPACE_SUCCESSOR"},
    "proposal_id": {"type": "string", "pattern": "^SNSP-[0-9a-f]{32}$"},
    "programme_id": {"const": "SU-TRIALS-CTGOV-v0.1"},
    "created_at": {"type": "string", "minLength": 10},
    "created_by": {"type": "string", "minLength": 1},
    "identity_boundary": {"const": "LOCAL_UNAUTHENTICATED_ATTRIBUTION"},
    "base_source_namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "materialized_source_count": {"type": "integer", "minimum": 1},
        "source_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "known_ctgov_nct_count": {"type": "integer", "minimum": 0},
        "known_nct_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["materialized_source_count", "source_ids_sha256", "known_ctgov_nct_count", "known_nct_index_sha256"]
    },
    "decision_provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projection_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workbench_query_id": {"type": "string", "minLength": 1},
        "workbench_run_id": {"type": "string", "pattern": "^DRUN-[0-9a-f]{32}$"}
      },
      "required": ["projection_manifest_sha256", "review_index_sha256", "decision_packet_sha256", "workbench_query_id", "workbench_run_id"]
    },
    "accepted_proposal_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DSP-[0-9a-f]{32}$"}
    },
    "accepted_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "canonical_locator": {"type": "string", "minLength": 1},
          "source_class": {"type": "string", "minLength": 1},
          "source_origin": {"const": "DISCOVERY_CTGOV_RECORDED_REPLAY_HUMAN_ACCEPTED"},
          "namespace_admission_state": {"const": "PROPOSED_NOT_CANONICAL"},
          "from_proposal_id": {"type": "string", "pattern": "^DSP-[0-9a-f]{32}$"},
          "workbench_adjudication_id": {"type": "string", "pattern": "^DADJ-[0-9a-f]{32}$"},
          "query_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "normalized_aggregate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "candidate_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "claim_boundary": {"type": "string", "minLength": 1}
        },
        "required": [
          "source_id",
          "nct_id",
          "title",
          "publisher",
          "canonical_locator",
          "source_class",
          "source_origin",
          "namespace_admission_state",
          "from_proposal_id",
          "workbench_adjudication_id",
          "query_ids",
          "normalized_aggregate_digest",
          "candidate_input_sha256",
          "claim_boundary"
        ]
      }
    },
    "overwrite_refused": {"const": true},
    "source_namespace_publication_performed": {"const": false},
    "monitor_creation_performed": {"const": false},
    "trial_entity_creation_performed": {"const": false},
    "trial_site_relationship_creation_performed": {"const": false},
    "assessment_mutation_performed": {"const": false},
    "canonical_successor_ready": {"const": false},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "artifact",
    "status",
    "proposal_id",
    "programme_id",
    "created_at",
    "created_by",
    "identity_boundary",
    "base_source_namespace",
    "decision_provenance",
    "accepted_proposal_ids",
    "accepted_sources",
    "overwrite_refused",
    "source_namespace_publication_performed",
    "monitor_creation_performed",
    "trial_entity_creation_performed",
    "trial_site_relationship_creation_performed",
    "assessment_mutation_performed",
    "canonical_successor_ready",
    "authority_boundary"
  ]
}
