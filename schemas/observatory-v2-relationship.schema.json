{
  "$id": "observatory-v2-relationship.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuroAI Observatory v2 typed relationship",
  "description": "Noncanonical migration/design schema for a source-backed relationship whose predecessor endpoints may remain unresolved literals. Observation links may be present when the predecessor refresh records an exact source check.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0.0-draft", "type": "string"},
    "relationship_id": {"type": "string", "minLength": 1},
    "relationship_family": {"type": "string", "enum": ["TRIAL_SITE", "PARTICIPANT_AUTHORITY", "SUPPLIER_DEPENDENCY"]},
    "relationship_type": {"type": "string", "minLength": 1},
    "subject_reference": {"$ref": "#/$defs/endpointReference"},
    "object_reference": {"$ref": "#/$defs/endpointReference"},
    "qualifiers": {"type": "object"},
    "observed_at": {"$ref": "#/$defs/nullableTemporalValue"},
    "knowledge_time_state": {"type": "string", "enum": ["EXACT_PREDECESSOR_TIME", "PREDECESSOR_TIME_UNRESOLVED"]},
    "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "observation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_linkage_state": {"const": "SOURCE_LINKED", "type": "string"},
    "evidence_state": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_id": {"const": "data-v0.1.0-public-governing", "type": "string"},
        "file": {"type": "string", "enum": ["canonical_observatory_release_v1.4.json", "adjudicated_delta_v1.6.json"]},
        "section": {"type": "string", "enum": ["trial_site_relationships", "participant_authority_relationships", "supplier_dependency_relationships"]},
        "record_id": {"type": "string", "minLength": 1},
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "payload": {"type": "object"}
      },
      "required": ["release_id", "file", "section", "record_id", "record_sha256", "payload"]
    },
    "record_state": {"const": "NONCANONICAL_MIGRATED_CANDIDATE", "type": "string"},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "relationship_id", "relationship_family", "relationship_type", "subject_reference", "object_reference", "qualifiers", "observed_at", "knowledge_time_state", "source_ids", "observation_ids", "source_linkage_state", "evidence_state", "claim_boundary", "predecessor", "record_state", "authority_boundary"],
  "$defs": {
    "endpointReference": {"type": "object", "additionalProperties": false, "properties": {"value": {"type": "string", "minLength": 1}, "resolution_state": {"const": "PREDECESSOR_LITERAL_UNRESOLVED", "type": "string"}, "entity_id": {"type": "null"}}, "required": ["value", "resolution_state", "entity_id"]},
    "temporalValue": {"type": "object", "additionalProperties": false, "properties": {"value": {"type": "string", "minLength": 1}, "precision": {"type": "string", "enum": ["TIMESTAMP", "DATE", "MONTH", "YEAR", "INTERVAL", "UNRESOLVED"]}}, "required": ["value", "precision"]},
    "nullableTemporalValue": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/temporalValue"}]}
  }
}
