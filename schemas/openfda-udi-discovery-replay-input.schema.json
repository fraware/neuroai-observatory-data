{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"openfda-udi-discovery-replay-input.schema.json",
  "title":"Recorded replay input for SU-REGULATION openFDA UDI",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","programme_id","provider","capture_scope","captured_at","leaf_query_captures"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "programme_id":{"const":"SU-REGULATION-OPENFDA-UDI-v0.1"},
    "provider":{"const":"U.S. FDA openFDA Unique Device Identifier API (GUDID)"},
    "capture_scope":{"enum":["FULL_PROGRAMME","PARTIAL_VALIDATION"]},
    "captured_at":{"type":"string","minLength":1},
    "leaf_query_captures":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["query_id","leaf_query_id","effective_search","partition_path","pages"],"properties":{"query_id":{"type":"string","minLength":1},"leaf_query_id":{"type":"string","minLength":1},"effective_search":{"type":"string","minLength":1},"partition_path":{"type":"array","maxItems":1,"items":{"type":"object","additionalProperties":false,"required":["dimension","lower_bound","upper_bound"],"properties":{"dimension":{"const":"PUBLIC_VERSION_DATE"},"lower_bound":{"type":"string","minLength":1},"upper_bound":{"type":"string","minLength":1}}}},"pages":{"type":"array","minItems":1,"items":{"type":"object"}}}}}
  }
}
