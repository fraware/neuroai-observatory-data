    "identity_policy":{"type":"object"},"inclusion_policy":{"type":"object"},"paging_policy":{"type":"object"},
    "query_streams":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["query_id","search","cadence","status","scope_tiers","purpose","completeness_claim"],"properties":{"query_id":{"type":"string","pattern":"^DISCOVERY-OPENFDA-510K-[A-Z0-9-]+$"},"search":{"type":"string","minLength":1},"cadence":{"const":"MONTHLY"},"status":{"const":"ACTIVE"},"scope_tiers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["A","B","C","D"]}},"purpose":{"type":"string","minLength":1},"completeness_claim":{"const":false}}}},
    "candidate_projection":{"type":"object"},"coverage_contract":{"type":"object"},"human_review_contract":{"type":"object"},"network_policy":{"type":"object"},"boundary":{"type":"string","minLength":1}
  }
