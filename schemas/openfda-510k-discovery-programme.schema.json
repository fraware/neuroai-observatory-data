{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"openfda-510k-discovery-programme.schema.json",
  "title":"SU-REGULATION openFDA 510(k) discovery programme",
  "type":"object","additionalProperties":false,
  "required":["schema_version","programme_id","status","source_universe_id","source_system","as_of","provider_contract","workbench_dependency","identity_policy","inclusion_policy","paging_policy","query_streams","candidate_projection","coverage_contract","human_review_contract","network_policy","boundary"],
  "properties":{
    "schema_version":{"const":"1.0.0-draft"},"programme_id":{"const":"SU-REGULATION-OPENFDA-510K-v0.1"},"status":{"const":"NONCANONICAL_PROGRAMME_CONTROL"},"source_universe_id":{"const":"SU-REGULATION"},"source_system":{"const":"OPENFDA_DEVICE_510K"},"as_of":{"type":"string","format":"date"},
    "provider_contract":{"type":"object","additionalProperties":false,"required":["provider","endpoint","method","response_media_type","source_dataset","time_period_start","provider_update_frequency","reported_denominator_path","skip_path","limit_path","results_path","primary_submission_id_field","max_records_per_request","max_skip","max_direct_result_count","provider_supports_search_after","provider_supports_bulk_downloads","configuration_performs_http"],"properties":{"provider":{"const":"U.S. FDA openFDA Device 510(k) API"},"endpoint":{"const":"https://api.fda.gov/device/510k.json"},"method":{"const":"GET"},"response_media_type":{"const":"application/json"},"source_dataset":{"const":"510(k) Clearances"},"time_period_start":{"const":"1976"},"provider_update_frequency":{"const":"MONTHLY"},"reported_denominator_path":{"const":"meta.results.total"},"skip_path":{"const":"meta.results.skip"},"limit_path":{"const":"meta.results.limit"},"results_path":{"const":"results"},"primary_submission_id_field":{"const":"k_number"},"max_records_per_request":{"const":1000},"max_skip":{"const":25000},"max_direct_result_count":{"const":26000},"provider_supports_search_after":{"const":true},"provider_supports_bulk_downloads":{"const":true},"configuration_performs_http":{"const":false}}},
