{
  "$id": "ctgov-first-capture-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClinicalTrials.gov first-capture operational summary",
  "description": "Sanitized operational summary for explicitly authorized pre-registry CT.gov primary captures. Raw bytes stay in Workbench quarantine and are never represented by this artifact.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "nullable_string": {"type": ["string", "null"]}
  },
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "artifact": {"const": "ctgov_first_capture_summary"},
    "status": {"const": "NONCANONICAL_OPERATIONAL_FIRST_CAPTURE"},
    "onboarding_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_packet_sha256": {"$ref": "#/$defs/sha256"},
    "workbench_commit": {"const": "a25b09bdf0533e73cbaf65d909acf4a4fa0fc065"},
    "collector_profile_id": {"const": "CTGOV_FIRST_CAPTURE_V0_1"},
    "collector_configuration_hash": {"$ref": "#/$defs/sha256"},
    "execution_mode": {"enum": ["INJECTED_TEST_TRANSPORT", "OPT_IN_NETWORK"]},
    "capture_execution_performed": {"type": "boolean"},
    "network_execution_performed": {"type": "boolean"},
    "authorized_capture_count": {"type": "integer", "minimum": 0},
    "deferred_capture_count": {"type": "integer", "minimum": 0},
    "capture_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "draft_monitor_id": {"type": "string", "pattern": "^DMON-[0-9a-f]{32}$"},
          "request_id": {"type": "string", "pattern": "^CREQ-[0-9a-f]{32}$"},
          "source_id": {"type": "string", "minLength": 1},
          "expected_nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
          "requested_url": {"type": "string", "pattern": "^https://clinicaltrials\\.gov/api/v2/studies/NCT[0-9]{8}$"},
          "requested_at": {"$ref": "#/$defs/timestamp"},
          "execution_state": {
            "enum": [
              "CAPTURED_IDENTITY_VERIFIED_PENDING_QUARANTINE_REVIEW",
              "CAPTURED_IDENTITY_MISMATCH_BLOCKED",
              "CAPTURED_JSON_INVALID_BLOCKED",
              "COLLECTOR_FAILURE"
            ]
          },
          "result_id": {"type": ["string", "null"], "pattern": "^CRES-[0-9a-f]{32}$"},
          "failure_id": {"type": ["string", "null"], "pattern": "^CFAIL-[0-9a-f]{32}$"},
          "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
          "content_sha256": {"$ref": "#/$defs/nullable_sha256"},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "quarantine_id": {"type": ["string", "null"], "pattern": "^QREC-[0-9a-f]{32}$"},
          "quarantine_approval_state": {"type": ["string", "null"]},
          "evidence_state": {"type": ["string", "null"]},
          "observed_nct_id": {"type": ["string", "null"], "pattern": "^NCT[0-9]{8}$"},
          "normalized_aggregate_digest": {"$ref": "#/$defs/nullable_sha256"},
          "identity_match": {"type": ["boolean", "null"]},
          "handoff_eligible": {"const": false},
          "raw_bytes_in_summary": {"const": false},
          "boundary": {"type": "string", "minLength": 1}
        },
        "required": [
          "draft_monitor_id",
          "request_id",
          "source_id",
          "expected_nct_id",
          "requested_url",
          "requested_at",
          "execution_state",
          "result_id",
          "failure_id",
          "http_status",
          "content_sha256",
          "size_bytes",
          "quarantine_id",
          "quarantine_approval_state",
          "evidence_state",
          "observed_nct_id",
          "normalized_aggregate_digest",
          "identity_match",
          "handoff_eligible",
          "raw_bytes_in_summary",
          "boundary"
        ]
      }
    },
    "quarantine_approval_performed": {"const": false},
    "monitoring_handoff_performed": {"const": false},
    "monitor_registry_successor_created": {"const": false},
    "monitor_creation_performed": {"const": false},
    "source_namespace_publication_performed": {"const": false},
    "trial_entity_creation_performed": {"const": false},
    "trial_site_relationship_creation_performed": {"const": false},
    "assessment_mutation_performed": {"const": false},
    "canonical_successor_ready": {"const": false},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "artifact",
    "status",
    "onboarding_manifest_sha256",
    "authorization_packet_sha256",
    "workbench_commit",
    "collector_profile_id",
    "collector_configuration_hash",
    "execution_mode",
    "capture_execution_performed",
    "network_execution_performed",
    "authorized_capture_count",
    "deferred_capture_count",
    "capture_rows",
    "quarantine_approval_performed",
    "monitoring_handoff_performed",
    "monitor_registry_successor_created",
    "monitor_creation_performed",
    "source_namespace_publication_performed",
    "trial_entity_creation_performed",
    "trial_site_relationship_creation_performed",
    "assessment_mutation_performed",
    "canonical_successor_ready",
    "authority_boundary"
  ]
}
