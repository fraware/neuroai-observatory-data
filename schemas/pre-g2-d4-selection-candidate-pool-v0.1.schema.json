{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neuroai:observatory:d4-selection-candidate-pool:0.1",
  "title": "PRE-G2 D4 controlled candidate-pool input",
  "description": "Schema for S3-only pre-label D4 candidate metadata used by deterministic challenge selection. Real candidate identities and membership must not be committed to public Git.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "protocol_id", "candidate_pool_id", "candidate_pool_commitment", "candidate_pool_frozen", "candidates"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "benchmark_id": {"const": "PRE_G2_PRODUCT_V0_1"},
    "protocol_id": {"const": "PRE_G2_D4_SAMPLING_CALIBRATION_PROTOCOL_2026-09-09_v0.1"},
    "candidate_pool_id": {"type": "string", "minLength": 1},
    "candidate_pool_commitment": {"$ref": "#/$defs/sha256"},
    "candidate_pool_frozen": {"const": true},
    "candidates": {"type": "array", "minItems": 240, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "construct_strata",
        "source_languages",
        "jurisdictions",
        "exact_object_identity_resolved",
        "exposure_status",
        "semantic_validation_passed",
        "human_confirmed_construct_tags",
        "pilot_or_development_exposed"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "construct_strata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["AMBIGUOUS_BIOSIGNAL", "CLINICAL", "CONSUMER", "ENTERTAINMENT_XR", "MULTI_JURISDICTION", "MULTILINGUAL", "NONTRADITIONAL_FORM_FACTOR", "RESEARCH", "WELLNESS", "WORKPLACE"]}
        },
        "source_languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exact_object_identity_resolved": {"const": true},
        "exposure_status": {"const": "NO_KNOWN_EXPOSURE_REVIEWED"},
        "semantic_validation_passed": {"const": true},
        "human_confirmed_construct_tags": {"const": true},
        "pilot_or_development_exposed": {"const": false}
      }
    }
  }
}
