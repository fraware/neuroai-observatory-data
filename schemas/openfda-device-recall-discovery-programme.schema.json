{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openfda-device-recall-discovery-programme.schema.json",
  "title": "SU-REGULATION openFDA device-recall discovery programme",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","programme_id","status","source_universe_id","source_system","as_of","provider_contract","workbench_dependency","identity_policy","inclusion_policy","paging_policy","query_streams","candidate_projection","coverage_contract","human_review_contract","network_policy","boundary"],
  "properties": {
    "schema_version": {"const":"1.0.0-draft"},
    "programme_id": {"const":"SU-REGULATION-OPENFDA-DEVICE-RECALLS-v0.1"},
    "status": {"const":"NONCANONICAL_PROGRAMME_CONTROL"},
    "source_universe_id": {"const":"SU-REGULATION"},
    "source_system": {"const":"OPENFDA_DEVICE_RECALL"},
    "as_of": {"type":"string","format":"date"},
    "provider_contract": {
      "type":"object","additionalProperties":false,
      "required":["provider","endpoint","method","response_media_type","source_dataset","time_period_start","provider_update_frequency","reported_denominator_path","skip_path","limit_path","results_path","primary_recall_id_field","event_lineage_field","max_records_per_request","max_skip","max_direct_result_count","provider_supports_search_after","provider_supports_bulk_downloads","configuration_performs_http"],
      "properties": {
        "provider":{"const":"U.S. FDA openFDA Device Recall API"},
        "endpoint":{"const":"https://api.fda.gov/device/recall.json"},
        "method":{"const":"GET"},
        "response_media_type":{"const":"application/json"},
        "source_dataset":{"const":"Medical Device Recalls"},
        "time_period_start":{"const":"2002"},
        "provider_update_frequency":{"const":"WEEKLY"},
        "reported_denominator_path":{"const":"meta.results.total"},
        "skip_path":{"const":"meta.results.skip"},
        "limit_path":{"const":"meta.results.limit"},
        "results_path":{"const":"results"},
        "primary_recall_id_field":{"const":"cfres_id"},
        "event_lineage_field":{"const":"res_event_number"},
        "max_records_per_request":{"const":1000},
        "max_skip":{"const":25000},
        "max_direct_result_count":{"const":26000},
        "provider_supports_search_after":{"const":true},
        "provider_supports_bulk_downloads":{"const":true},
        "configuration_performs_http":{"const":false}
      }
    },
    "workbench_dependency": {
      "type":"object","additionalProperties":false,
      "required":["minimum_package_line","required_capability","integration_state"],
      "properties": {
        "minimum_package_line":{"const":"0.3.0.dev0"},
        "required_capability":{"const":"project_openfda_device_recall_pages"},
        "integration_state":{"enum":["NOT_IMPLEMENTED","PENDING_S1_MERGE","AVAILABLE"]}
      }
    },
    "identity_policy":{"type":"object"},
    "inclusion_policy":{"type":"object"},
    "paging_policy":{"type":"object"},
    "query_streams": {
      "type":"array","minItems":5,"maxItems":5,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["query_id","search","cadence","status","scope_tiers","purpose","completeness_claim"],
        "properties": {
          "query_id":{"type":"string","pattern":"^DISCOVERY-OPENFDA-RECALL-[A-Z0-9-]+$"},
          "search":{"type":"string","minLength":1},
          "cadence":{"const":"WEEKLY"},
          "status":{"const":"ACTIVE"},
          "scope_tiers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["A","B","C","D"]}},
          "purpose":{"type":"string","minLength":1},
          "completeness_claim":{"const":false}
        }
      }
    },
    "candidate_projection":{"type":"object"},
    "coverage_contract":{"type":"object"},
    "human_review_contract":{"type":"object"},
    "network_policy":{"type":"object"},
    "boundary":{"type":"string","minLength":1}
  }
}
