{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ctgov-first-capture-authorization.schema.json",
  "title": "Explicit local CT.gov first-capture authorization packet",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "artifact": {"const": "ctgov_first_capture_authorization_packet"},
    "status": {"const": "EXPLICIT_LOCAL_FIRST_CAPTURE_AUTHORIZATION"},
    "onboarding_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workbench_commit": {"const": "854cc9d1c8e24a9e8ae8b21d871329bc3c24c118"},
    "collector_profile_id": {"const": "CTGOV_FIRST_CAPTURE_V0_1"},
    "collector_configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorized_by": {"type": "string", "minLength": 1},
    "authorized_at": {"type": "string", "minLength": 20},
    "identity_boundary": {"const": "LOCAL_UNAUTHENTICATED_ATTRIBUTION"},
    "rationale": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "draft_monitor_id": {"type": "string", "pattern": "^DMON-[0-9a-f]{32}$"},
          "source_id": {"type": "string", "minLength": 1},
          "nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
          "request_id": {"type": "string", "pattern": "^CREQ-[0-9a-f]{32}$"},
          "primary_route_id": {"type": "string", "minLength": 1},
          "primary_url": {"type": "string", "pattern": "^https://clinicaltrials\\.gov/api/v2/studies/NCT[0-9]{8}$"},
          "decision": {"enum": ["AUTHORIZE_PRIMARY_CAPTURE", "DEFER"]},
          "rationale": {"type": "string", "minLength": 1}
        },
        "required": [
          "draft_monitor_id",
          "source_id",
          "nct_id",
          "request_id",
          "primary_route_id",
          "primary_url",
          "decision",
          "rationale"
        ]
      }
    },
    "network_execution_authorized": {"const": true},
    "primary_route_only": {"const": true},
    "fallback_capture_authorized": {"const": false},
    "quarantine_approval_authorized": {"const": false},
    "monitor_registry_successor_authorized": {"const": false},
    "source_namespace_publication_authorized": {"const": false},
    "trial_entity_creation_authorized": {"const": false},
    "trial_site_relationship_creation_authorized": {"const": false},
    "assessment_mutation_authorized": {"const": false},
    "canonical_publication_authorized": {"const": false},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "artifact",
    "status",
    "onboarding_manifest_sha256",
    "workbench_commit",
    "collector_profile_id",
    "collector_configuration_sha256",
    "authorized_by",
    "authorized_at",
    "identity_boundary",
    "rationale",
    "decisions",
    "network_execution_authorized",
    "primary_route_only",
    "fallback_capture_authorized",
    "quarantine_approval_authorized",
    "monitor_registry_successor_authorized",
    "source_namespace_publication_authorized",
    "trial_entity_creation_authorized",
    "trial_site_relationship_creation_authorized",
    "assessment_mutation_authorized",
    "canonical_publication_authorized",
    "authority_boundary"
  ]
}
