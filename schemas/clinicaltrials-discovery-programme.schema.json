{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"clinicaltrials-discovery-programme.schema.json",
  "title":"SU-TRIALS ClinicalTrials.gov discovery programme",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","programme_id","status","source_universe_id","source_system","as_of","workbench_dependency","identity_policy","inclusion_policy","request_policy","known_identifier_anchors","query_streams","coverage_contract","network_policy","boundary"],
  "properties":{
    "schema_version":{"const":"1.0.0-draft"},
    "programme_id":{"const":"SU-TRIALS-CTGOV-v0.1"},
    "status":{"const":"NONCANONICAL_PROGRAMME_CONTROL"},
    "source_universe_id":{"const":"SU-TRIALS"},
    "source_system":{"const":"CLINICALTRIALS_GOV"},
    "as_of":{"type":"string","format":"date"},
    "workbench_dependency":{"type":"object","additionalProperties":false,"required":["minimum_package_line","required_capability","integration_state"],"properties":{"minimum_package_line":{"const":"0.3.0.dev0"},"required_capability":{"const":"project_clinicaltrials_search_pages"},"integration_state":{"const":"AVAILABLE"}}},
    "identity_policy":{"type":"object","additionalProperties":false,"required":["registry_identity_key","fuzzy_identity_merge_allowed","cross_query_deduplication","conflicting_same_id_policy","known_identifier_match"],"properties":{"registry_identity_key":{"const":"NCT_ID"},"fuzzy_identity_merge_allowed":{"const":false},"cross_query_deduplication":{"const":"EXACT_NCT_ID"},"conflicting_same_id_policy":{"const":"FAIL_CLOSED"},"known_identifier_match":{"const":"EXACT_NCT_TO_CONTROLLED_SOURCE_ID"}}},
    "inclusion_policy":{"type":"object","additionalProperties":false,"required":["required_study_types","automatic_trial_entity_creation","automatic_trial_site_relationship_creation","automatic_source_admission","automatic_monitor_creation","automatic_assessment_mutation","participant_level_data_collection","human_relevance_review_required"],"properties":{"required_study_types":{"const":["INTERVENTIONAL"]},"automatic_trial_entity_creation":{"const":false},"automatic_trial_site_relationship_creation":{"const":false},"automatic_source_admission":{"const":false},"automatic_monitor_creation":{"const":false},"automatic_assessment_mutation":{"const":false},"participant_level_data_collection":{"const":false},"human_relevance_review_required":{"const":true}}},
    "request_policy":{"type":"object","additionalProperties":false,"required":["api_endpoint","query_parameter","count_total_first_page","count_total_later_pages","pagination_mode","total_count_reconciliation_required_for_mechanical_completion"],"properties":{"api_endpoint":{"const":"/api/v2/studies"},"query_parameter":{"const":"query.term"},"count_total_first_page":{"const":true},"count_total_later_pages":{"const":false},"pagination_mode":{"const":"OPAQUE_NEXT_PAGE_TOKEN"},"total_count_reconciliation_required_for_mechanical_completion":{"const":true}}},
    "known_identifier_anchors":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"object","additionalProperties":false,"required":["anchor_id","nct_id","existing_source_id","purpose","counts_as_new_discovery"],"properties":{"anchor_id":{"const":"CTGOV-ANCHOR-PRIMA-001"},"nct_id":{"const":"NCT04676854"},"existing_source_id":{"const":"SRC-PR-002"},"purpose":{"type":"string","minLength":1},"counts_as_new_discovery":{"const":false}}}},
    "query_streams":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["query_id","query_term","query_surface","post_retrieval_required_study_types","page_size","cadence","status","purpose","completeness_claim"],"properties":{"query_id":{"type":"string","pattern":"^DISCOVERY-CTGOV-[A-Z0-9-]+$"},"query_term":{"type":"string","minLength":1},"query_surface":{"const":"query.term"},"post_retrieval_required_study_types":{"const":["INTERVENTIONAL"]},"page_size":{"const":100},"cadence":{"const":"MONTHLY"},"status":{"const":"ACTIVE"},"purpose":{"type":"string","minLength":1},"completeness_claim":{"const":false}}}},
    "coverage_contract":{"type":"object","additionalProperties":false,"required":["required_metrics","mechanical_completion_requires","registry_completeness_claim","global_neuroai_trial_recall_claim","fully_paginated_semantics","reported_total_semantics"],"properties":{"required_metrics":{"type":"array","minItems":14,"uniqueItems":true,"items":{"type":"string"}},"mechanical_completion_requires":{"type":"object","additionalProperties":false,"required":["pagination_sequence_valid","fully_paginated","reported_total_count_state","reported_total_reconciliation_state"],"properties":{"pagination_sequence_valid":{"const":true},"fully_paginated":{"const":true},"reported_total_count_state":{"const":"CONSISTENT"},"reported_total_reconciliation_state":{"const":"MATCH"}}},"registry_completeness_claim":{"const":false},"global_neuroai_trial_recall_claim":{"const":false},"fully_paginated_semantics":{"type":"string","minLength":1},"reported_total_semantics":{"type":"string","minLength":1}}},
    "network_policy":{"type":"object","additionalProperties":false,"required":["live_execution","requires_workbench_network_gate","configuration_performs_http","hosted_success_claim_allowed_without_runner_steps"],"properties":{"live_execution":{"const":"OPT_IN_ONLY"},"requires_workbench_network_gate":{"const":true},"configuration_performs_http":{"const":false},"hosted_success_claim_allowed_without_runner_steps":{"const":false}}},
    "boundary":{"type":"string","minLength":1}
  }
}
