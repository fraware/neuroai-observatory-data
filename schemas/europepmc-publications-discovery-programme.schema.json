{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"europepmc-publications-discovery-programme.schema.json",
  "title":"SU-PUBLICATIONS Europe PMC discovery programme",
  "type":"object","additionalProperties":false,
  "required":["schema_version","programme_id","status","source_universe_id","source_system","as_of","provider_contract","workbench_dependency","identity_policy","inclusion_policy","known_identifier_anchors","query_streams","candidate_projection","coverage_contract","human_review_contract","network_policy","boundary"],
  "properties":{
    "schema_version":{"const":"1.0.0-draft"},"programme_id":{"const":"SU-PUBLICATIONS-EUROPEPMC-v0.1"},"status":{"const":"NONCANONICAL_PROGRAMME_CONTROL"},"source_universe_id":{"const":"SU-PUBLICATIONS"},"source_system":{"const":"EUROPE_PMC"},"as_of":{"type":"string","format":"date"},
    "provider_contract":{"type":"object"},
    "workbench_dependency":{"type":"object","additionalProperties":false,"required":["minimum_package_line","required_capability","integration_state"],"properties":{"minimum_package_line":{"const":"0.3.0.dev0"},"required_capability":{"const":"project_europepmc_search_pages"},"integration_state":{"const":"AVAILABLE"}}},
    "identity_policy":{"type":"object"},"inclusion_policy":{"type":"object"},
    "known_identifier_anchors":{"type":"array","minItems":2},
    "query_streams":{"type":"array","minItems":8,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["query_id","query_term","cadence","status","scope_tiers","purpose","completeness_claim"],"properties":{"query_id":{"type":"string","pattern":"^DISCOVERY-EPMC-[A-Z0-9-]+$"},"query_term":{"type":"string","minLength":1},"cadence":{"enum":["WEEKLY","MONTHLY"]},"status":{"const":"ACTIVE"},"scope_tiers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["A","B","C","D"]}},"purpose":{"type":"string","minLength":1},"completeness_claim":{"const":false}}}},
    "candidate_projection":{"type":"object"},"coverage_contract":{"type":"object"},"human_review_contract":{"type":"object"},"network_policy":{"type":"object"},"boundary":{"type":"string","minLength":1}
  }
}
