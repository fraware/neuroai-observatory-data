{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"openfda-hde-discovery-replay-input.schema.json",
  "title":"SU-REGULATION openFDA HDE recorded replay input",
  "type":"object","additionalProperties":false,
