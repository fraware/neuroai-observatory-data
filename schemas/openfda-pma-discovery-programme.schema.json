  "properties":{
    "schema_version":{"const":"1.0.0-draft"},"programme_id":{"const":"SU-REGULATION-OPENFDA-PMA-v0.1"},"status":{"const":"NONCANONICAL_PROGRAMME_CONTROL"},"source_universe_id":{"const":"SU-REGULATION"},"source_system":{"const":"OPENFDA_DEVICE_PMA"},"as_of":{"type":"string","format":"date"},
    "provider_contract":{"type":"object","additionalProperties":false,"required":["provider","endpoint","method","response_media_type","source_dataset","time_period_start","provider_update_frequency","reported_denominator_path","skip_path","limit_path","results_path","application_lineage_field","supplement_record_field","max_records_per_request","max_skip","max_direct_result_count","provider_supports_search_after","provider_supports_bulk_downloads","configuration_performs_http"],"properties":{"provider":{"const":"U.S. FDA openFDA Device PMA API"},"endpoint":{"const":"https://api.fda.gov/device/pma.json"},"method":{"const":"GET"},"response_media_type":{"const":"application/json"},"source_dataset":{"const":"Premarket Approval (PMA) decisions"},"time_period_start":{"const":"1976"},"provider_update_frequency":{"const":"MONTHLY"},"reported_denominator_path":{"const":"meta.results.total"},"skip_path":{"const":"meta.results.skip"},"limit_path":{"const":"meta.results.limit"},"results_path":{"const":"results"},"application_lineage_field":{"const":"pma_number"},"supplement_record_field":{"const":"supplement_number"},"max_records_per_request":{"const":1000},"max_skip":{"const":25000},"max_direct_result_count":{"const":26000},"provider_supports_search_after":{"const":true},"provider_supports_bulk_downloads":{"const":true},"configuration_performs_http":{"const":false}}},
