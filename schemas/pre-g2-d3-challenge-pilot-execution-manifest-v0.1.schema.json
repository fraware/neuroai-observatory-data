{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neuroai:observatory:d3-challenge-pilot-execution-manifest:0.1",
  "title": "PRE-G2 D3 controlled patent challenge pilot execution manifest",
  "description": "S3-only 60-family pilot execution manifest. Real packet references, family identities, human labels, evidence and reviewer references remain controlled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "protocol_id",
    "pilot_round_id",
    "state",
    "pilot_membership_commitment",
    "pilot_membership_commitment_scheme",
    "reviewer_training_record_sha256",
    "exposure_register_sha256",
    "prior_exposure_disjointness_audit_sha256",
    "packet_manifest"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "benchmark_id": {"const": "PRE_G2_PATENT_V0_1"},
    "protocol_id": {"const": "PRE_G2_D3_CHALLENGE_SAMPLING_CALIBRATION_PROTOCOL_2026-09-11_v0.1"},
    "pilot_round_id": {"type": "string", "minLength": 1},
    "state": {"const": "COMPLETE_ROUND_NO_EXTENSION"},
    "pilot_membership_commitment": {"$ref": "#/$defs/sha256"},
    "pilot_membership_commitment_scheme": {"const": "HMAC_SHA256_DOMAIN_CANONICAL_JSON_V1"},
    "reviewer_training_record_sha256": {"$ref": "#/$defs/sha256"},
    "exposure_register_sha256": {"$ref": "#/$defs/sha256"},
    "prior_exposure_disjointness_audit_sha256": {"$ref": "#/$defs/sha256"},
    "packet_manifest": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/packet_entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlled_packet_ref", "packet_sha256"],
      "properties": {
        "controlled_packet_ref": {"type": "string", "minLength": 1},
        "packet_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
