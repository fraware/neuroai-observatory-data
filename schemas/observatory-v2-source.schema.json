{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"observatory-v2-source.schema.json",
  "title":"NeuroAI Observatory v2 Source identity candidate",
  "description":"Noncanonical v2 Source identity. Discovery-origin records preserve explicit human-accepted provenance but do not establish substantive truth, monitoring, or canonical publication authority.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","source_id","title","publisher","canonical_locator","source_class","legacy_source_ids","source_claim_boundary","source_origin","discovery_provenance","record_state","authority_boundary"],
  "properties":{
    "schema_version":{"const":"2.0.0-draft"},"source_id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"publisher":{"type":"string","minLength":1},"canonical_locator":{"type":"string","minLength":1},"source_class":{"type":"string","minLength":1},"legacy_source_ids":{"type":"array","maxItems":0},"source_claim_boundary":{"type":"string","minLength":1},"source_origin":{"const":"DISCOVERY_HUMAN_ACCEPTED_SOURCE_NAMESPACE_PROPOSAL"},
    "discovery_provenance":{"type":"object","additionalProperties":false,"required":["source_namespace_successor_proposal_id","programme_id","projection_manifest_sha256","review_index_sha256","decision_packet_sha256","workbench_query_id","workbench_run_id","workbench_proposal_id","workbench_adjudication_id","nct_id","query_ids","normalized_aggregate_digest","candidate_input_sha256","projection_source_id_set_sha256","staging_source_id_set_sha256","adjudication_base_source_id_set_sha256"],"properties":{"source_namespace_successor_proposal_id":{"type":"string","pattern":"^SNSP-[0-9a-f]{32}$"},"programme_id":{"const":"SU-TRIALS-CTGOV-v0.1"},"projection_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"review_index_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"decision_packet_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"workbench_query_id":{"type":"string","minLength":1},"workbench_run_id":{"type":"string","pattern":"^DRUN-[0-9a-f]{32}$"},"workbench_proposal_id":{"type":"string","pattern":"^DSP-[0-9a-f]{32}$"},"workbench_adjudication_id":{"type":"string","pattern":"^DADJ-[0-9a-f]{32}$"},"nct_id":{"type":"string","pattern":"^NCT[0-9]{8}$"},"query_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"normalized_aggregate_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"candidate_input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"projection_source_id_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"staging_source_id_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"adjudication_base_source_id_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "record_state":{"const":"NONCANONICAL_DISCOVERY_ADMITTED_CANDIDATE"},"authority_boundary":{"type":"string","minLength":1}
  }
}
