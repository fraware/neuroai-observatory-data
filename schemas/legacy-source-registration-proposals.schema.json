{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/neuroai-observatory-data/schemas/legacy-source-registration-proposals.schema.json",
  "title": "Legacy assessment source registration proposals",
  "type": "object",
  "required": ["schema_version", "artifact", "status", "derived_from", "authority_boundary", "proposals"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "artifact": {"const": "legacy_assessment_source_registration_proposals"},
    "status": {"const": "NONCANONICAL_PROPOSAL"},
    "authority_boundary": {"type": "string", "minLength": 1},
    "derived_from": {
      "type": "object",
      "required": ["programme_checkpoint", "source_universe_count", "assessment_evidence_count", "deterministic_matched_evidence_count", "unresolved_evidence_count", "registration_eligible_evidence_count", "exact_identity_source_proposal_count", "missing_explicit_source_count", "curation_required_count", "fuzzy_matching"],
      "properties": {
        "programme_checkpoint": {"type": "string"},
        "source_universe_count": {"type": "integer"},
        "assessment_evidence_count": {"type": "integer"},
        "deterministic_matched_evidence_count": {"type": "integer"},
        "unresolved_evidence_count": {"type": "integer"},
        "registration_eligible_evidence_count": {"type": "integer"},
        "exact_identity_source_proposal_count": {"type": "integer"},
        "missing_explicit_source_count": {"type": "integer"},
        "curation_required_count": {"type": "integer"},
        "fuzzy_matching": {"const": false}
      },
      "additionalProperties": false
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["proposal_id", "action", "review_state", "identity_rule", "identity_rationale", "normalized_public_url", "checksum", "existing_source_id", "requested_source_id", "linked_evidence", "impacted_requirement_count", "impacted_requirement_ids", "source_boundary_note"],
        "properties": {
          "proposal_id": {"type": "string", "pattern": "^LEGACY-SRC-PROP-[0-9]{3}$"},
          "action": {"enum": ["REGISTER_NEW_SOURCE", "REGISTER_MISSING_EXPLICIT_SOURCE", "REUSE_EXISTING_SOURCE", "CURATION_REQUIRED"]},
          "review_state": {"const": "PROPOSED_NONCANONICAL"},
          "identity_rule": {"type": "string", "minLength": 1},
          "identity_rationale": {"type": "string", "minLength": 1},
          "normalized_public_url": {"type": ["string", "null"]},
          "checksum": {"type": ["string", "null"]},
          "existing_source_id": {"type": ["string", "null"]},
          "requested_source_id": {"type": ["string", "null"]},
          "proposed_source_record": {
            "type": "object",
            "required": ["source_id", "title", "publisher", "url", "published", "retrieved", "source_class", "evidence_state", "supports", "claim_boundary"],
            "properties": {
              "source_id": {"type": "string"},
              "title": {"type": "string"},
              "publisher": {"type": "string"},
              "url": {"type": "string"},
              "published": {"type": "string"},
              "retrieved": {"type": "string"},
              "source_class": {"type": "string"},
              "evidence_state": {"type": "string"},
              "supports": {"type": "string"},
              "claim_boundary": {"type": "string"}
            },
            "additionalProperties": false
          },
          "linked_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["system", "assessment_version", "evidence_id", "title", "source_label", "evidence_type", "evidence_class", "publication_state"],
              "properties": {
                "system": {"type": "string"},
                "assessment_version": {"type": "string"},
                "evidence_id": {"type": "string"},
                "title": {"type": "string"},
                "source_label": {"type": ["string", "null"]},
                "evidence_type": {"type": ["string", "null"]},
                "evidence_class": {"type": ["string", "null"]},
                "publication_state": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          },
          "impacted_requirement_count": {"type": "integer"},
          "impacted_requirement_ids": {"type": "array", "items": {"type": "string"}},
          "source_boundary_note": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
