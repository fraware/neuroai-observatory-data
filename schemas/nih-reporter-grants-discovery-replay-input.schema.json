{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nih-reporter-grants-discovery-replay-input.schema.json",
  "title": "SU-GRANTS NIH RePORTER recorded replay input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "programme_id", "provider", "capture_scope", "captured_at", "leaf_query_captures"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "programme_id": {"const": "SU-GRANTS-NIH-REPORTER-v0.1"},
    "provider": {"const": "NIH RePORTER API"},
    "capture_scope": {"enum": ["FULL_PROGRAMME", "PARTIAL_VALIDATION"]},
    "captured_at": {"type": "string", "minLength": 1},
    "leaf_query_captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "leaf_query_id", "query_payload", "partition_path", "pages"],
        "properties": {
          "query_id": {"type": "string", "pattern": "^DISCOVERY-REPORTER-[A-Z0-9-]+$"},
          "leaf_query_id": {"type": "string", "minLength": 1},
          "query_payload": {"type": "object", "minProperties": 1},
          "partition_path": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimension", "value"],
              "properties": {
                "dimension": {"enum": ["FISCAL_YEAR", "AWARD_NOTICE_DATE"]},
                "value": {"type": ["string", "integer"]}
              }
            }
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "object"}
          }
        }
      }
    }
  }
}
