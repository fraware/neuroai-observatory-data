    "leaf_query_captures":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["query_id","leaf_query_id","query_payload","partition_path","pages"],"properties":{"query_id":{"type":"string","pattern":"^DISCOVERY-REPORTER-[A-Z0-9-]+$"},"leaf_query_id":{"type":"string","minLength":1},"query_payload":{"type":"object"},"partition_path":{"type":"array","maxItems":2,"items":{"oneOf":[{"type":"object","additionalProperties":false,"required":["dimension","fiscal_year"],"properties":{"dimension":{"const":"FISCAL_YEAR"},"fiscal_year":{"type":"integer","minimum":1900,"maximum":2100}}},{"type":"object","additionalProperties":false,"required":["dimension","from_date","to_date"],"properties":{"dimension":{"const":"AWARD_NOTICE_DATE"},"from_date":{"type":"string","format":"date"},"to_date":{"type":"string","format":"date"}}}]}},"pages":{"type":"array","minItems":1,"items":{"type":"object"}}}}}
  }
