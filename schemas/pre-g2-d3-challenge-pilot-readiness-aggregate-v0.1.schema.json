{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neuroai:observatory:d3-challenge-pilot-readiness-aggregate:0.1",
  "title": "PRE-G2 D3 patent challenge pilot readiness aggregate",
  "description": "Aggregate-only schema for a complete 60-family D3 challenge calibration round. Real patent identities, evidence, reviewer references, rationales and labels remain S3-controlled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "protocol_id",
    "pilot_round_id",
    "state",
    "total_items",
    "double_labeled_items",
    "primary_secondary_exact_agreement_count",
    "primary_secondary_confusion_matrix",
    "adjudicated_disagreement_count",
    "unresolved_disagreement_count",
    "resolved_disposition_counts",
    "required_stratum_counts",
    "per_stratum_disagreement_counts",
    "semantic_validation_failure_count",
    "reviewer_reference_collision_count",
    "evidence_binding_failure_count",
    "blinding_exception_count",
    "blinding_exception_with_rationale_count",
    "pilot_items_held_out_eligible_count",
    "pilot_membership_commitment",
    "pilot_membership_commitment_scheme",
    "reviewer_training_record_sha256",
    "exposure_register_sha256",
    "prior_exposure_disjointness_audit_sha256",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "benchmark_id": {"const": "PRE_G2_PATENT_V0_1"},
    "protocol_id": {"const": "PRE_G2_D3_CHALLENGE_SAMPLING_CALIBRATION_PROTOCOL_2026-09-11_v0.1"},
    "pilot_round_id": {"type": "string", "minLength": 1},
    "state": {"const": "COMPLETE_ROUND_NO_EXTENSION"},
    "total_items": {"const": 60},
    "double_labeled_items": {"const": 60},
    "primary_secondary_exact_agreement_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "primary_secondary_confusion_matrix": {"$ref": "#/$defs/confusion_matrix"},
    "adjudicated_disagreement_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "unresolved_disagreement_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "resolved_disposition_counts": {"$ref": "#/$defs/disposition_counts"},
    "required_stratum_counts": {"$ref": "#/$defs/stratum_counts"},
    "per_stratum_disagreement_counts": {"$ref": "#/$defs/stratum_counts"},
    "semantic_validation_failure_count": {"type": "integer", "minimum": 0},
    "reviewer_reference_collision_count": {"type": "integer", "minimum": 0},
    "evidence_binding_failure_count": {"type": "integer", "minimum": 0},
    "blinding_exception_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "blinding_exception_with_rationale_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "pilot_items_held_out_eligible_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "pilot_membership_commitment": {"$ref": "#/$defs/sha256"},
    "pilot_membership_commitment_scheme": {"const": "HMAC_SHA256_DOMAIN_CANONICAL_JSON_V1"},
    "reviewer_training_record_sha256": {"$ref": "#/$defs/sha256"},
    "exposure_register_sha256": {"$ref": "#/$defs/sha256"},
    "prior_exposure_disjointness_audit_sha256": {"$ref": "#/$defs/sha256"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 60},
    "disposition_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ABSTAIN", "BORDERLINE", "EXCLUDE", "INCLUDE"],
      "properties": {
        "ABSTAIN": {"$ref": "#/$defs/count"},
        "BORDERLINE": {"$ref": "#/$defs/count"},
        "EXCLUDE": {"$ref": "#/$defs/count"},
        "INCLUDE": {"$ref": "#/$defs/count"}
      }
    },
    "confusion_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ABSTAIN", "BORDERLINE", "EXCLUDE", "INCLUDE"],
      "properties": {
        "ABSTAIN": {"$ref": "#/$defs/count"},
        "BORDERLINE": {"$ref": "#/$defs/count"},
        "EXCLUDE": {"$ref": "#/$defs/count"},
        "INCLUDE": {"$ref": "#/$defs/count"}
      }
    },
    "confusion_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ABSTAIN", "BORDERLINE", "EXCLUDE", "INCLUDE"],
      "properties": {
        "ABSTAIN": {"$ref": "#/$defs/confusion_row"},
        "BORDERLINE": {"$ref": "#/$defs/confusion_row"},
        "EXCLUDE": {"$ref": "#/$defs/confusion_row"},
        "INCLUDE": {"$ref": "#/$defs/confusion_row"}
      }
    },
    "stratum_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GRAY_CAPABILITY",
        "MISSING_OR_SHORT_ABSTRACT",
        "MULTI_JURISDICTION",
        "MULTI_YEAR",
        "MULTILINGUAL",
        "SEMANTICALLY_DECEPTIVE_NEGATIVE"
      ],
      "properties": {
        "GRAY_CAPABILITY": {"$ref": "#/$defs/count"},
        "MISSING_OR_SHORT_ABSTRACT": {"$ref": "#/$defs/count"},
        "MULTI_JURISDICTION": {"$ref": "#/$defs/count"},
        "MULTI_YEAR": {"$ref": "#/$defs/count"},
        "MULTILINGUAL": {"$ref": "#/$defs/count"},
        "SEMANTICALLY_DECEPTIVE_NEGATIVE": {"$ref": "#/$defs/count"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_competence_established",
        "benchmark_adequacy_established",
        "g2_passed",
        "canonical_s2_authority",
        "publication_authority",
        "population_generalization_authority",
        "assessment_effect"
      ],
      "properties": {
        "reviewer_competence_established": {"const": false},
        "benchmark_adequacy_established": {"const": false},
        "g2_passed": {"const": false},
        "canonical_s2_authority": {"const": false},
        "publication_authority": {"const": false},
        "population_generalization_authority": {"const": false},
        "assessment_effect": {"const": "NONE"}
      }
    }
  }
}
