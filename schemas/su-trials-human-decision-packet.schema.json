{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"su-trials-human-decision-packet.schema.json",
  "title":"SU-TRIALS explicit local human decision packet",
  "description":"Operator-supplied dispositions over exactly one staged SU-TRIALS Workbench discovery run. The adjudicator string is local attribution only and does not authenticate identity, independence, delegation, or institutional authority.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","artifact","status","programme_id","projection_manifest_sha256","review_index_sha256","workbench_query_id","workbench_run_id","adjudicated_by","adjudicated_at","identity_boundary","decisions","source_namespace_admission_only","monitor_creation_authorized","trial_entity_creation_authorized","trial_site_relationship_creation_authorized","assessment_mutation_authorized","canonical_publication_authorized","authority_boundary"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "artifact":{"const":"su_trials_human_decision_packet"},
    "status":{"const":"EXPLICIT_LOCAL_HUMAN_DECISION_PACKET"},
    "programme_id":{"const":"SU-TRIALS-CTGOV-v0.1"},
    "projection_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "review_index_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "workbench_query_id":{"type":"string","pattern":"^DISCOVERY-[A-Z0-9][A-Z0-9_-]{0,96}$"},
    "workbench_run_id":{"type":"string","pattern":"^DRUN-[0-9a-f]{32}$"},
    "adjudicated_by":{"type":"string","minLength":1},
    "adjudicated_at":{"type":"string","minLength":10},
    "identity_boundary":{"const":"LOCAL_UNAUTHENTICATED_ATTRIBUTION"},
    "decisions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["proposal_id","nct_id","decision","rationale"],"properties":{"proposal_id":{"type":"string","pattern":"^DSP-[0-9a-f]{32}$"},"nct_id":{"type":"string","pattern":"^NCT[0-9]{8}$"},"decision":{"enum":["ACCEPT","REJECT","DEFER","EXCLUDE"]},"rationale":{"type":"string","minLength":1}}}},
    "source_namespace_admission_only":{"const":true},
    "monitor_creation_authorized":{"const":false},
    "trial_entity_creation_authorized":{"const":false},
    "trial_site_relationship_creation_authorized":{"const":false},
    "assessment_mutation_authorized":{"const":false},
    "canonical_publication_authorized":{"const":false},
    "authority_boundary":{"type":"string","minLength":1}
  }
}
