{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/neuroai-observatory-data/schemas/vnext/entity-resolution-decision.schema.json",
  "title": "NeuroAI vNext entity resolution decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind","decision_id","candidate_id","left_entity_id","right_entity_id","disposition","authority_mode","decided_by","decided_at","rationale","evidence_references","canonical_effect","automatic_mutation_performed"],
  "properties": {
    "record_kind": {"const": "ENTITY_RESOLUTION_DECISION"},
    "decision_id": {"type": "string", "pattern": "^ERD-[A-Z0-9-]{3,120}$"},
    "candidate_id": {"type": "string", "pattern": "^ERC-[A-Z0-9-]{3,120}$"},
    "left_entity_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,127}$"},
    "right_entity_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,127}$"},
    "disposition": {"enum": ["SAME_ENTITY","KEEP_DISTINCT","INSUFFICIENT_EVIDENCE"]},
    "authority_mode": {"const": "HUMAN_ADJUDICATED"},
    "decided_by": {"type": "string", "minLength": 2},
    "decided_at": {"type": "string", "format": "date-time"},
    "rationale": {"type": "string", "minLength": 10},
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,127}$"}},
    "canonical_effect": {"enum": ["MERGE_SUCCESSOR_REQUIRED","NO_MERGE","NO_CANONICAL_EFFECT"]},
    "automatic_mutation_performed": {"const": false}
  }
}
