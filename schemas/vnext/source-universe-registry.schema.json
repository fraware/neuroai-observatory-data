{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/neuroai-observatory-data/schemas/vnext/source-universe-registry.schema.json",
  "title": "NeuroAI vNext source-universe registry index",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "schema_version", "status", "created_at", "required_p0_domains", "fragments", "authority_boundary"],
  "properties": {
    "registry_id": {"const": "SOURCE-UNIVERSE-REGISTRY-V0.1"},
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "PLANNING_CONTROL_METADATA_NOT_CANONICAL_PRODUCTION_DATA"},
    "created_at": {"type": "string", "format": "date-time"},
    "required_p0_domains": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"enum": ["SCIENCE", "CLINICAL", "REGULATORY", "PUBLIC_FUNDING", "PATENT_IP", "CAPITAL", "NEURAL_DATA"]}},
    "fragments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "domains", "record_count"],
        "properties": {
          "path": {"type": "string", "pattern": "^source-universes/p0/[a-z0-9][a-z0-9.-]*\\.json$"},
          "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["SCIENCE", "CLINICAL", "REGULATORY", "PUBLIC_FUNDING", "PATENT_IP", "CAPITAL", "NEURAL_DATA"]}},
          "record_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "authority_boundary": {"type": "string", "minLength": 20}
  }
}
