{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/neuroai-observatory-data/schemas/vnext/source-universe.schema.json",
  "title": "NeuroAI vNext source universe",
  "type": "object",
  "additionalProperties": false,
  "required": ["universe_id", "schema_version", "name", "domain", "priority", "planning_state", "provider", "interface", "rights", "freeze", "temporal_scope", "update_semantics", "closure", "limitations", "authority_boundary"],
  "properties": {
    "universe_id": {"type": "string", "pattern": "^SU-[A-Z0-9-]{3,64}$"},
    "schema_version": {"const": "0.1.0"},
    "name": {"type": "string", "minLength": 3},
    "domain": {"enum": ["SCIENCE", "CLINICAL", "REGULATORY", "PUBLIC_FUNDING", "PATENT_IP", "CAPITAL", "NEURAL_DATA"]},
    "priority": {"enum": ["P0", "P1", "P2"]},
    "planning_state": {"enum": ["VERIFIED_INTERFACE", "INTERFACE_VERIFICATION_PENDING", "PROVIDER_SELECTION_PENDING", "DEFERRED"]},
    "provider": {
      "type": "object", "additionalProperties": false, "required": ["name", "documentation_url"],
      "properties": {"name": {"type": "string", "minLength": 2}, "documentation_url": {"type": "string", "format": "uri"}, "jurisdiction": {"type": ["string", "null"]}}
    },
    "interface": {
      "type": "object", "additionalProperties": false, "required": ["access_mode", "base_url", "authentication_class", "pagination_or_exhaustion", "machine_readable"],
      "properties": {
        "access_mode": {"enum": ["REST_API", "GRAPHQL_API", "BULK_SNAPSHOT", "BULK_EXPORT", "SPARQL", "WEB_EXPORT", "LICENSED_EXPORT", "HYBRID"]},
        "base_url": {"type": ["string", "null"], "format": "uri"},
        "authentication_class": {"enum": ["NONE_PUBLIC_READ", "FREE_API_KEY", "OAUTH_CLIENT", "ACCOUNT_REQUIRED", "LICENSE_REQUIRED", "UNKNOWN_PENDING_VERIFICATION"]},
        "pagination_or_exhaustion": {"type": "string", "minLength": 3},
        "machine_readable": {"const": true}
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false, "required": ["access_rights_class", "redistribution_rights_class", "raw_bytes_publication", "rights_note"],
      "properties": {
        "access_rights_class": {"enum": ["OPEN_PUBLIC", "PUBLIC_WITH_TERMS", "REGISTERED_ACCESS", "LICENSED_RESTRICTED", "UNKNOWN_PENDING_REVIEW"]},
        "redistribution_rights_class": {"enum": ["OPEN_REDISSEMINATION", "METADATA_REDISSEMINATION_ONLY", "SOURCE_TERMS_GOVERN", "NO_REDISSEMINATION", "UNKNOWN_PENDING_REVIEW"]},
        "raw_bytes_publication": {"enum": ["PERMITTED", "PROHIBITED", "NOT_APPLICABLE", "REQUIRES_CASE_REVIEW"]},
        "rights_note": {"type": "string", "minLength": 3}
      }
    },
    "freeze": {
      "type": "object", "additionalProperties": false, "required": ["freeze_unit", "query_or_extract_identity", "source_state_identity", "content_digest_required"],
      "properties": {
        "freeze_unit": {"enum": ["QUERY", "SNAPSHOT", "EXPORT", "API_DATABASE_STATE", "PROVIDER_RELEASE", "LICENSED_DELIVERY"]},
        "query_or_extract_identity": {"type": "string", "minLength": 3},
        "source_state_identity": {"type": "string", "minLength": 3},
        "content_digest_required": {"const": true}
      }
    },
    "temporal_scope": {
      "type": "object", "additionalProperties": false, "required": ["valid_time_model", "transaction_time_required"],
      "properties": {
        "valid_time_model": {"enum": ["EVENT_DATE", "PUBLICATION_DATE", "AWARD_PERIOD", "TRIAL_LIFECYCLE", "REGULATORY_LIFECYCLE", "DATASET_VERSION", "FILING_DATE", "MIXED_EXPLICIT"]},
        "transaction_time_required": {"const": true}
      }
    },
    "update_semantics": {
      "type": "object", "additionalProperties": false, "required": ["cadence_state", "change_detection"],
      "properties": {
        "cadence_state": {"enum": ["CONTINUOUS_OR_DAILY", "WEEKDAY", "DAILY", "WEEKLY", "MONTHLY", "QUARTERLY", "PROVIDER_DEFINED", "ON_DEMAND", "UNKNOWN_PENDING_VERIFICATION"]},
        "change_detection": {"enum": ["CURSOR_DELTA", "VERSION_DIFF", "FULL_RECONCILIATION", "EVENT_INCREMENT", "SNAPSHOT_DIFF", "PROVIDER_DELTA", "MANUAL_REVIEW"]},
        "cadence_note": {"type": "string"}
      }
    },
    "closure": {
      "type": "object", "additionalProperties": false, "required": ["closure_type", "denominator_method", "allowed_completeness_claim"],
      "properties": {
        "closure_type": {"enum": ["ENUMERABLE_QUERY_RESULT", "ENUMERABLE_RELEASE", "ENUMERABLE_REGISTRY", "DECLARED_SEARCH_UNIVERSE", "LICENSED_DELIVERY", "OPEN_WORLD_DISCOVERY"]},
        "denominator_method": {"enum": ["API_TOTAL", "EXHAUSTED_CURSOR_COUNT", "RELEASE_RECORD_COUNT", "REGISTRY_RECORD_COUNT", "DECLARED_CANDIDATE_SET", "DELIVERY_RECORD_COUNT", "NO_GLOBAL_DENOMINATOR"]},
        "allowed_completeness_claim": {"enum": ["COMPLETE_WITHIN_FROZEN_QUERY", "COMPLETE_WITHIN_PROVIDER_RELEASE", "COMPLETE_WITHIN_DECLARED_REGISTRY", "COMPLETE_WITHIN_DECLARED_CANDIDATE_SET", "COMPLETE_WITHIN_LICENSED_DELIVERY", "COVERAGE_ONLY_NO_COMPLETENESS"]}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "authority_boundary": {"type": "string", "minLength": 20}
  }
}
