{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/neuroai-observatory-data/schemas/vnext/acquisition-freeze.schema.json",
  "title": "NeuroAI vNext acquisition freeze",
  "type": "object",
  "additionalProperties": false,
  "required": ["freeze_id","schema_version","source_universe_id","adapter_id","adapter_version","protocol_id","query_family_ids","retrieval_cutoff","source_state_identity","request_identity_sha256","raw_response_manifest_sha256","raw_bytes_location_class","records_observed","exhaustion_state","canonical_effect","created_at","authority_boundary"],
  "properties": {
    "freeze_id": {"type":"string","pattern":"^AF-[A-Z0-9-]{3,100}$"},
    "schema_version": {"const":"0.1.0"},
    "source_universe_id": {"type":"string","pattern":"^SU-SCI-[A-Z0-9-]+$"},
    "adapter_id": {"type":"string","pattern":"^ADAPTER-[A-Z0-9-]{3,80}$"},
    "adapter_version": {"const":"0.1.0"},
    "protocol_id": {"const":"SCIENCE-DISCOVERY-PROTOCOL-V0.1"},
    "query_family_ids": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^QF-[A-Z0-9-]{2,40}$"}},
    "retrieval_cutoff": {"type":"string","format":"date-time"},
    "source_state_identity": {"type":"string","minLength":3},
    "request_identity_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "raw_response_manifest_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "raw_bytes_location_class": {"enum":["OUTSIDE_GIT_CONTENT_ADDRESSED","PROVIDER_SNAPSHOT_REFERENCE"]},
    "records_observed": {"type":"integer","minimum":0},
    "exhaustion_state": {"enum":["COMPLETE","PARTIAL","FAILED"]},
    "continuation_state": {"type":["string","null"]},
    "failure_reason": {"type":["string","null"]},
    "canonical_effect": {"const":"NONE_CANDIDATE_DISCOVERY_ONLY"},
    "created_at": {"type":"string","format":"date-time"},
    "authority_boundary": {"type":"string","minLength":30}
  },
  "allOf": [
    {"if":{"properties":{"exhaustion_state":{"const":"COMPLETE"}}},"then":{"properties":{"failure_reason":{"type":"null"}}}},
    {"if":{"properties":{"exhaustion_state":{"enum":["PARTIAL","FAILED"]}}},"then":{"required":["failure_reason"]}}
  ]
}
