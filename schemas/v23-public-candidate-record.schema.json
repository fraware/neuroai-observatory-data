{
  "$id": "v23-public-candidate-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "$schema": {"type": "string"},
    "artifact": {"minLength": 1, "type": "string"},
