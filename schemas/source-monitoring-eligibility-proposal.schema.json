{
  "$id": "source-monitoring-eligibility-proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source monitoring eligibility proposal",
  "description": "Noncanonical monitoring recommendation package for newly materialized Source candidates. Recommendations do not create monitor-registry entries or authorize cadence automatically.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "artifact": {"const": "source_monitoring_eligibility_proposal"},
    "status": {"const": "NONCANONICAL_PENDING_MONITOR_REVIEW"},
    "source_namespace_successor_proposal_id": {"type": "string", "pattern": "^SNSP-[0-9a-f]{32}$"},
    "source_candidate_count": {"type": "integer", "minimum": 1},
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "proposal_id": {"type": "string", "pattern": "^SMEP-[0-9a-f]{32}$"},
          "source_id": {"type": "string", "minLength": 1},
          "nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
          "source_class": {"type": "string", "minLength": 1},
          "recommended_mode": {"type": "string", "enum": ["ARCHIVAL_STATIC", "RECURRING", "ON_CHANGE"]},
          "recommended_cadence": {"type": ["string", "null"]},
          "priority": {"enum": ["LOW", "NORMAL", "HIGH"]},
          "reason": {"type": "string", "minLength": 1},
          "review_state": {"const": "PENDING_MONITOR_REVIEW"},
          "monitor_present": {"const": false},
          "monitor_creation_performed": {"const": false}
        },
        "required": [
          "proposal_id",
          "source_id",
          "nct_id",
          "source_class",
          "recommended_mode",
          "recommended_cadence",
          "priority",
          "reason",
          "review_state",
          "monitor_present",
          "monitor_creation_performed"
        ]
      }
    },
    "automatic_registry_mutation": {"const": false},
    "monitor_creation_performed": {"const": false},
    "source_namespace_publication_performed": {"const": false},
    "trial_entity_creation_performed": {"const": false},
    "trial_site_relationship_creation_performed": {"const": false},
    "assessment_mutation_performed": {"const": false},
    "canonical_successor_ready": {"const": false},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "artifact",
    "status",
    "source_namespace_successor_proposal_id",
    "source_candidate_count",
    "proposals",
    "automatic_registry_mutation",
    "monitor_creation_performed",
    "source_namespace_publication_performed",
    "trial_entity_creation_performed",
    "trial_site_relationship_creation_performed",
    "assessment_mutation_performed",
    "canonical_successor_ready",
    "authority_boundary"
  ]
}
