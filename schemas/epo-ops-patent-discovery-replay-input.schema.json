{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epo-ops-patent-discovery-replay-input.schema.json",
  "title": "SU-PATENTS EPO OPS recorded replay input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "programme_id", "capture_scope", "captured_at", "provider", "leaf_query_captures"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "programme_id": {"const": "SU-PATENTS-EPO-OPS-v0.1"},
    "capture_scope": {"enum": ["FULL_PROGRAMME", "PARTIAL_VALIDATION"]},
    "captured_at": {"type": "string", "minLength": 1},
    "provider": {"const": "European Patent Office Open Patent Services"},
    "leaf_query_captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "leaf_query_id", "effective_cql", "applicant_term", "partition_path", "search_constituent", "response_media_type", "range_transport", "pages"],
        "properties": {
          "query_id": {"type": "string", "pattern": "^DISCOVERY-OPS-[A-Z0-9-]+$"},
          "leaf_query_id": {"type": "string", "minLength": 1},
          "effective_cql": {"type": "string", "minLength": 1},
          "applicant_term": {"type": ["string", "null"]},
          "partition_path": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimension", "lower_bound", "upper_bound"],
              "properties": {
                "dimension": {"enum": ["PUBLICATION_DATE_YEAR", "PUBLICATION_DATE_MONTH"]},
                "lower_bound": {"type": "string", "minLength": 1},
                "upper_bound": {"type": "string", "minLength": 1}
              }
            }
          },
          "search_constituent": {"const": "biblio"},
          "response_media_type": {"const": "application/exchange+xml"},
          "range_transport": {"const": "X-OPS-Range"},
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["xml"],
              "properties": {"xml": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}
